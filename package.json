{
  "name": "koishi-plugin-adapter-harness",
  "version": "0.1.0",
  "description": "Bridge Koishi conversations to a DeepSeek Harness runtime.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "bin": {
    "koishi-harness-runtime": "./dist/runtime.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    ".env.example",
    "CONTRIBUTING.md",
    "LICENSE",
    "PLAN.md",
    "README.md",
    "SECURITY.md",
    "examples"
  ],
  "scripts": {
    "build": "pkgroll --sourcemap",
    "check": "npm run check-types && npm run test && npm run build && npm run test:runtime && npm run test:koishi && npm run publint",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist coverage tsconfig.tsbuildinfo",
    "publint": "publint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:koishi": "node scripts/smoke-koishi.mjs",
    "test:runtime": "node scripts/smoke-runtime.mjs",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "koishi",
    "plugin",
    "deepseek",
    "harness",
    "agent",
    "chatbot"
  ],
  "homepage": "https://github.com/nazidada/koishi-plugin-adapter-harness#readme",
  "bugs": {
    "url": "https://github.com/nazidada/koishi-plugin-adapter-harness/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nazidada/koishi-plugin-adapter-harness.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "koishi": {
    "category": "ai",
    "description": {
      "zh": "将 Koishi 会话桥接到 DeepSeek Harness Agent 运行时。",
      "en": "Bridge Koishi conversations to a DeepSeek Harness agent runtime."
    },
    "service": {
      "implements": [
        "harnessAdapter"
      ]
    }
  },
  "peerDependencies": {
    "koishi": "^4.18.11"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent-spine-demo": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-client": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "koishi": "^4.18.11",
    "pkgroll": "^2.27.1",
    "publint": "^0.3.13",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@10.9.3"
}
